# true = toda la app con datos de prueba. false = servidor real.
EXPO_PUBLIC_USE_MOCKS=true
# Host del VPS, sin puerto ni "/" final
EXPO_PUBLIC_API_HOST=http://2.24.29.189
EXPO_PUBLIC_PORT_AVISOS=30001
EXPO_PUBLIC_PORT_TALLERES=30002
EXPO_PUBLIC_PORT_INSCRIPCIONES=30003
# Con USE_MOCKS=false, servicios que siguen con datos de prueba (separados por coma). Talleres aún no está desplegado.
EXPO_PUBLIC_MOCK_SERVICES=talleres
