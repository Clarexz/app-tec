flowchart LR
  subgraph CEL["Celular del alumno (Android)"]
    APP["App CampusConectado<br/>Expo SDK 58 · React Native 0.88<br/>HTTP plano (cleartext)"]
  end

  INTERNET(("Internet"))

  subgraph VPS["VPS · Ubuntu 24.04 · IP pública 203.0.113.10 (ficticia)"]
