      end
      subgraph NS3["namespace equipo3"]
        NP2["NodePort 30002"] --> S2["Service talleres"] --> P2["Pod talleres<br/>Flask · Python 3.12"]
      end
      subgraph NS4["namespace equipo4"]
        NP3["NodePort 30003"] --> S3["Service inscripciones"] --> P3["Pod inscripciones<br/>Flask · Python 3.12"]
        P3 --> PVC[("PVC<br/>SQLite inscripciones.db")]
      end
    end
  end

  APP -- "GET /avisos · /salud" --> INTERNET
